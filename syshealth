#!/usr/bin/env bash
# =============================================================
#  syshealth — modular system health checker for Arch Linux
#  Usage: syshealth [--battery] [--temps] [--memory] [--disk]
#                   [--system] [--net] [--all] [--help]
# =============================================================

set -euo pipefail

# ── Colours ──────────────────────────────────────────────────
RED='\033[0;31m'; GREEN='\033[0;32m'; YELLOW='\033[1;33m'
CYAN='\033[0;36m'; BOLD='\033[1m'; DIM='\033[2m'; RESET='\033[0m'

# ── Helpers ───────────────────────────────────────────────────
section() { echo -e "\n${CYAN}${BOLD}┌─ $* ${RESET}${DIM}──────────────────────────────${RESET}"; }
warn()    { echo -e "${YELLOW}  ⚠  $*${RESET}"; }
ok()      { echo -e "${GREEN}  ✔  $*${RESET}"; }
info()    { echo -e "  ${DIM}$*${RESET}"; }

# ── Auto-detect hardware ──────────────────────────────────────
BAT_NAME="BAT0"
for b in BAT0 BAT1; do
  [[ -d "/sys/class/power_supply/$b" ]] && { BAT_NAME="$b"; break; }
done

DISK_DEV="/dev/sda"
for d in /dev/nvme0 /dev/sda; do
  [[ -e "$d" ]] && { DISK_DEV="$d"; break; }
done

# ── Section functions ─────────────────────────────────────────

show_battery() {
  section "Battery"
  local bat_path="/sys/class/power_supply/$BAT_NAME"

  if [[ ! -d "$bat_path" ]]; then
    warn "No battery found at $bat_path"; return
  fi

  local pct state energy_full energy_full_design cycles
  pct=$(upower -i "$(upower -e | grep BAT)" 2>/dev/null | awk '/percentage/ {print $2}')
  state=$(upower -i "$(upower -e | grep BAT)" 2>/dev/null | awk '/state/ {print $2}')
  energy_full=$(cat "$bat_path/energy_full" 2>/dev/null || echo 0)
  energy_full_design=$(cat "$bat_path/energy_full_design" 2>/dev/null || echo 1)
  cycles=$(cat "$bat_path/cycle_count" 2>/dev/null || echo "N/A")

  local health=$(( energy_full * 100 / energy_full_design ))

  echo -e "  Charge:      ${BOLD}${pct}${RESET}  (${state})"
  echo -e "  Cycles:      ${BOLD}${cycles}${RESET}"

  if (( health >= 80 )); then
    echo -e "  Health:      ${GREEN}${BOLD}${health}%${RESET}  ✔ Good"
  elif (( health >= 60 )); then
    echo -e "  Health:      ${YELLOW}${BOLD}${health}%${RESET}  ⚠ Degraded"
  else
    echo -e "  Health:      ${RED}${BOLD}${health}%${RESET}  ✘ Replace soon"
  fi

  # Drain rate if discharging
  if [[ -f "$bat_path/power_now" ]]; then
    local drain=$(cat "$bat_path/power_now")
    local drain_w=$(( drain / 1000000 ))
    [[ "$state" == "discharging" ]] && echo -e "  Drain rate:  ${BOLD}${drain_w}W${RESET}"
  fi
}

show_temps() {
  section "Thermals"
  if ! command -v sensors &>/dev/null; then
    warn "lm_sensors not installed. Run: sudo pacman -S lm_sensors"; return
  fi

  # Parse sensors output — only lines like "Label:  +57.0°C"
  while IFS= read -r line; do
    # Must match "word(s):   +XX.X°C" pattern — skips crit/low/high annotations
    if [[ "$line" =~ ^[A-Za-z][^:]+:[[:space:]]+[+-][0-9]+\.[0-9]+°C ]]; then
      local temp label temp_int
      temp=$(echo "$line" | grep -oP '[+-]?\d+\.\d+(?=°C)' | head -1)
      label=$(echo "$line" | awk -F: '{print $1}' | xargs)
      # Strip decimal for integer comparison (bash can't do floats)
      temp_int=${temp%.*}
      temp_int=${temp_int#+}   # remove leading +

      if (( temp_int >= 90 )); then
        echo -e "  ${RED}${BOLD}✘ $label: ${temp}°C  ← CRITICAL${RESET}"
      elif (( temp_int >= 80 )); then
        echo -e "  ${YELLOW}⚠ $label: ${temp}°C  ← Hot${RESET}"
      elif (( temp_int >= 60 )); then
        echo -e "  ${YELLOW}~ $label: ${temp}°C${RESET}"
      else
        echo -e "  ${GREEN}✔ $label: ${temp}°C${RESET}"
      fi
    fi
  done < <(sensors 2>/dev/null)
}

show_memory() {
  section "Memory"
  local total used free avail swap_total swap_used

  read -r _ total used free _ _ avail _ < <(free -b | grep ^Mem)
  read -r _ swap_total swap_used _ < <(free -b | grep ^Swap)

  local used_pct=$(( used * 100 / total ))
  local total_h=$(( total / 1073741824 ))
  local used_h=$(( used / 1073741824 ))
  local avail_h=$(( avail / 1073741824 ))
  local swap_used_h=$(( swap_used / 1073741824 ))
  local swap_total_h=$(( swap_total / 1073741824 ))

  echo -e "  RAM:   ${BOLD}${used_h}GB used / ${total_h}GB total${RESET}  (${avail_h}GB available)"

  if (( used_pct >= 90 )); then
    echo -e "  Usage: ${RED}${BOLD}${used_pct}%  ← Critical${RESET}"
  elif (( used_pct >= 75 )); then
    echo -e "  Usage: ${YELLOW}${BOLD}${used_pct}%  ← High${RESET}"
  else
    echo -e "  Usage: ${GREEN}${BOLD}${used_pct}%  ✔${RESET}"
  fi

  echo -e "  Swap:  ${BOLD}${swap_used_h}GB used / ${swap_total_h}GB total${RESET}"
}

show_disk() {
  section "Disk"
  while IFS= read -r line; do
    [[ "$line" =~ ^Filesystem ]] && continue
    local pct
    pct=$(echo "$line" | awk '{print $5}' | tr -d '%')
    local mount
    mount=$(echo "$line" | awk '{print $6}')
    local size used avail
    size=$(echo "$line" | awk '{print $2}')
    used=$(echo "$line" | awk '{print $3}')
    avail=$(echo "$line" | awk '{print $4}')

    if (( pct >= 90 )); then
      echo -e "  ${RED}${BOLD}✘ $mount — ${pct}% used (${used}/${size})  ← Almost full${RESET}"
    elif (( pct >= 75 )); then
      echo -e "  ${YELLOW}⚠ $mount — ${pct}% used (${used}/${size})${RESET}"
    else
      echo -e "  ${GREEN}✔ $mount — ${pct}% used (${used}/${size})${RESET}"
    fi
  done < <(df -h --exclude-type=tmpfs 2>/dev/null)
}

show_system() {
  section "System"

  # Failed units
  local failed
  failed=$(systemctl --failed --no-legend 2>/dev/null | wc -l)
  if (( failed > 0 )); then
    echo -e "  ${RED}${BOLD}✘ Failed units: ${failed}${RESET}"
    systemctl --failed --no-legend 2>/dev/null | while read -r line; do
      echo -e "    ${DIM}${line}${RESET}"
    done
  else
    echo -e "  ${GREEN}✔ No failed systemd units${RESET}"
  fi

  # Recent errors
  local errors
  errors=$(journalctl -p 3 -b --no-pager -q 2>/dev/null | wc -l)
  if (( errors > 0 )); then
    warn "Journal errors this boot: ${errors} (run 'errlogs' to inspect)"
  else
    ok "No journal errors this boot"
  fi

  # Uptime
  local uptime_str
  uptime_str=$(uptime -p 2>/dev/null | sed 's/up //')
  info "Uptime: ${uptime_str}"
}

show_net() {
  section "Network"
  echo -ne "  Ping (1.1.1.1):  "
  local result
  result=$(ping -c 2 -W 2 1.1.1.1 2>/dev/null | tail -1 | awk -F '/' '{print $5}')
  if [[ -n "$result" ]]; then
    echo -e "${GREEN}${BOLD}${result}ms avg${RESET}"
  else
    echo -e "${RED}${BOLD}unreachable${RESET}"
  fi

  # Active interfaces
  ip -br addr show 2>/dev/null | grep -v "^lo" | while read -r iface state addr; do
    if [[ "$state" == "UP" ]]; then
      echo -e "  ${GREEN}✔ $iface${RESET}  ${DIM}${addr}${RESET}"
    else
      echo -e "  ${DIM}✘ $iface (down)${RESET}"
    fi
  done
}

# ── Usage ─────────────────────────────────────────────────────
usage() {
  echo -e "\n${BOLD}syshealth${RESET} — modular system health for Arch Linux\n"
  echo -e "  ${BOLD}Usage:${RESET}  syshealth [flags]\n"
  echo -e "  ${CYAN}--battery${RESET}   Battery charge, health & drain"
  echo -e "  ${CYAN}--temps${RESET}     CPU, GPU & NVMe temperatures"
  echo -e "  ${CYAN}--memory${RESET}    RAM & swap usage"
  echo -e "  ${CYAN}--disk${RESET}      Disk usage per partition"
  echo -e "  ${CYAN}--system${RESET}    Failed units & journal errors"
  echo -e "  ${CYAN}--net${RESET}       Network ping & interfaces"
  echo -e "  ${CYAN}--all${RESET}       Run all checks"
  echo -e "  ${CYAN}--help${RESET}      Show this message\n"
  echo -e "  ${DIM}Example:  syshealth --battery --temps${RESET}"
  echo -e "  ${DIM}Example:  syshealth --all${RESET}\n"
}

# ── Argument parsing ──────────────────────────────────────────
[[ $# -eq 0 ]] && { usage; exit 0; }

DO_BAT=0; DO_TEMPS=0; DO_MEM=0; DO_DISK=0; DO_SYS=0; DO_NET=0

for arg in "$@"; do
  case "$arg" in
    --battery) DO_BAT=1 ;;
    --temps)   DO_TEMPS=1 ;;
    --memory)  DO_MEM=1 ;;
    --disk)    DO_DISK=1 ;;
    --system)  DO_SYS=1 ;;
    --net)     DO_NET=1 ;;
    --all)     DO_BAT=1; DO_TEMPS=1; DO_MEM=1; DO_DISK=1; DO_SYS=1; DO_NET=1 ;;
    --help|-h) usage; exit 0 ;;
    *) echo -e "${RED}Unknown flag: $arg${RESET}  (try --help)"; exit 1 ;;
  esac
done

# ── Run selected sections ─────────────────────────────────────
echo -e "\n${BOLD}  syshealth${RESET}  ${DIM}$(date '+%a %d %b %Y  %H:%M:%S')${RESET}"

(( DO_BAT   )) && show_battery
(( DO_TEMPS )) && show_temps
(( DO_MEM   )) && show_memory
(( DO_DISK  )) && show_disk
(( DO_SYS   )) && show_system
(( DO_NET   )) && show_net

echo ""
